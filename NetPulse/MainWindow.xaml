<Window x:Class="NetPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetPulse"
        xmlns:vm="clr-namespace:NetPulse.ViewModels"
        xmlns:loc="clr-namespace:NetPulse.Localization"
        xmlns:models="clr-namespace:NetPulse.Models"
        mc:Ignorable="d"
        Title="NetPulse — Windows Tarmoq Diagnostikasi va Optimizatori" 
        Icon="Assets/app.ico"
        Height="800" Width="1180"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkestBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Top Header Bar -->
            <RowDefinition Height="64" />
            <!-- 1: Main Area (Sidebar + Tabs) -->
            <RowDefinition Height="*" />
            <!-- 2: Bottom Status & Telemetry Bar -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER BAR ================= -->
        <Border Grid.Row="0" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Logo & Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1D2E54" BorderBrush="#2563EB" BorderThickness="1.2" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#38BDF8" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Net" FontSize="19" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock Text="Pulse" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC" />
                            <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc AppSubtitle}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Active Network Badge Capsule -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#0C1322" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="20" Padding="14,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Glowing online dot -->
                            <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                                    Background="{Binding CurrentNetwork.IsConnected, Converter={StaticResource ScoreToColorConverter}}" />

                            <TextBlock Text="{Binding CurrentNetwork.ConnectionTypeDisplay, FallbackValue='Wi-Fi'}" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,6,0" FontSize="12" />
                            <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" FontSize="12" />
                            <TextBlock Text="{Binding CurrentNetwork.Ssid, FallbackValue='Tarmoqqa ulanmagan'}" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0" FontSize="12" />

                            <Border Visibility="{Binding CurrentNetwork.IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" FontSize="12" />
                                    <TextBlock Text="{Binding CurrentNetwork.BandDisplay, FallbackValue='5 GHz'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" FontSize="12" />
                                    <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" FontSize="12" />
                                    <TextBlock Text="{loc:Loc SignalLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock Text="{Binding CurrentNetwork.SignalPercentage, StringFormat='{}{0}%'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" FontSize="12" />
                                    <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" FontSize="12" />
                                    <TextBlock Text="{loc:Loc Link}" FontWeight="Bold" Foreground="#10B981" FontSize="12" />
                                    <TextBlock Text="{Binding CurrentNetwork.ReceiveRateMbps, StringFormat=': {0} Mbps'}" FontWeight="Bold" Foreground="#10B981" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Language Selector, Elevation & Refresh Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector Pill -->
                    <Border Background="#0C1322" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="14" Padding="3,2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="LangGroup" Content="UZ" Style="{StaticResource LangChipStyle}"
                                         IsChecked="{Binding CurrentLanguage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=uz, Mode=OneWay}"
                                         Command="{Binding SetLanguageCommand}" CommandParameter="uz" />
                            <RadioButton GroupName="LangGroup" Content="RU" Style="{StaticResource LangChipStyle}"
                                         IsChecked="{Binding CurrentLanguage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ru, Mode=OneWay}"
                                         Command="{Binding SetLanguageCommand}" CommandParameter="ru" />
                            <RadioButton GroupName="LangGroup" Content="EN" Style="{StaticResource LangChipStyle}"
                                         IsChecked="{Binding CurrentLanguage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=en, Mode=OneWay}"
                                         Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                        </StackPanel>
                    </Border>

                    <!-- Administrator badge if elevated -->
                    <Border Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#112920" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc AdminBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                        </StackPanel>
                    </Border>

                    <!-- Elevate to admin button if not elevated -->
                    <Button Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Command="{Binding RestartAsAdminCommand}"
                            Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0" Padding="10,5"
                            ToolTip="{loc:Loc AdminElevateTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc AdminElevateBtn}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" />
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshNetworkInfoCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="10,5"
                            ToolTip="{loc:Loc RefreshTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc RefreshBtn}" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN WORKSPACE (SIDEBAR + TABS) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="220" />
                <!-- Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Nav Items -->
                        <RowDefinition Height="*" />
                        <!-- Sidebar Bottom Card -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{loc:Loc NavMenu}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,8" />

                        <!-- Nav 0: Dashboard -->
                        <RadioButton GroupName="SidebarNav" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=0, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc NavDashboard}" FontSize="13" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Nav 1: Diagnostics -->
                        <RadioButton GroupName="SidebarNav" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=1, Mode=TwoWay}">
                            <Grid HorizontalAlignment="Stretch" Width="170">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="{loc:Loc NavDiagnostics}" FontSize="13" />
                                </StackPanel>

                                <!-- Issue badge if any -->
                                <Border HorizontalAlignment="Right" Background="#331A1D" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="10" Padding="6,1"
                                        Visibility="{Binding IssuesCount, Converter={StaticResource IntToVisibilityConverter}}">
                                    <TextBlock Text="{Binding IssuesCount}" FontSize="10" FontWeight="Bold" Foreground="#EF4444" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- Nav 2: Optimizations -->
                        <RadioButton GroupName="SidebarNav" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=2, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc NavOptimizations}" FontSize="13" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Nav 3: Speed Test -->
                        <RadioButton GroupName="SidebarNav" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=3, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc NavSpeedTest}" FontSize="13" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Nav 4: Activity Log -->
                        <RadioButton GroupName="SidebarNav" Style="{StaticResource SidebarNavRadioButtonStyle}"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=4, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📜" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc NavActivityLog}" FontSize="13" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Sidebar Bottom Card: Network Snapshot -->
                    <Border Grid.Row="1" Background="#0C1322" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc DeviceNetworkStatus}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding CurrentNetwork.AdapterName}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentNetwork.IpAddress, FallbackValue='IP yo\'q'}" FontSize="11" Foreground="#38BDF8" Margin="0,2,0,4" />

                            <Border Background="#162034" CornerRadius="4" Padding="6,3" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc ScorePrefix}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding HealthScore, StringFormat='{}{0}/100'}" FontSize="10" FontWeight="Bold" Foreground="{Binding HealthScore, Converter={StaticResource ScoreToColorConverter}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT TAB CONTENT AREA -->
            <Grid Grid.Column="1" Background="{StaticResource BgDarkestBrush}">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent" Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- ================= TAB 0: ASOSIY PANEL ================= -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Top Row: Score + 1-Click Fix -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Middle: Section Header -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Bottom: Parameter Cards -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top row: Score Card + 1-Click Hero Banner -->
                                <Grid Grid.Row="0" Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="340" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Health Score Card -->
                                    <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,16,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc HealthScoreTitle}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />

                                            <Grid Margin="0,14,0,10" HorizontalAlignment="Center">
                                                <!-- Radial Circle Score -->
                                                <Border Width="116" Height="116" CornerRadius="58" BorderThickness="5"
                                                        BorderBrush="{Binding HealthScore, Converter={StaticResource ScoreToColorConverter}}"
                                                        Background="#0A0E18">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding HealthScore}" FontSize="40" FontWeight="Bold" 
                                                                   Foreground="{Binding HealthScore, Converter={StaticResource ScoreToColorConverter}}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="/ 100" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding HealthStatusText}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#F8FAFC" Margin="0,0,0,8" TextAlignment="Center" />

                                            <!-- Counts breakdown -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                                <Border Cursor="Hand" Background="#142E25" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SuccessCount}" FontSize="11"
                                                                   FontWeight="Bold" Foreground="#10B981"/>
                                                        <TextBlock Text=" " />
                                                        <TextBlock Text="{loc:Loc NormalCountSuffix}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                    </StackPanel>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding OpenDiagnosticsCommand}"
                                                                      CommandParameter="{x:Static models:DiagnosticFilter.All}"
                                                                      />
                                                    </Border.InputBindings>
                                                </Border>
                                                <Border Cursor="Hand" Background="#331A1D" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IssuesCount}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
                                                        <TextBlock Text=" " />
                                                        <TextBlock Text="{loc:Loc IssuesCountSuffix}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
                                                    </StackPanel>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding OpenDiagnosticsCommand}"
                                                                      CommandParameter="{x:Static models:DiagnosticFilter.Issues}"
                                                                      />
                                                    </Border.InputBindings>
                                                </Border>
                                            </StackPanel>

                                            <!-- Diagnostics Button -->
                                            <Button Command="{Binding StartDiagnosticsCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Text="{loc:Loc DiagnosingBtn}" FontSize="13" />
                                                    <TextBlock Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}}" Text="{loc:Loc StartDiagnosticsBtn}" FontSize="13" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- 1-Click Hero Banner -->
                                    <Border Grid.Column="1" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="14" Padding="24">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#162A5A" Offset="0.0" />
                                                <GradientStop Color="#0B132B" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <Border Background="#2563EB" CornerRadius="5" HorizontalAlignment="Left" Padding="8,3" Margin="0,0,0,8">
                                                    <TextBlock Text="{loc:Loc HeroBadge}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                                <TextBlock Text="{loc:Loc HeroTitle}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                                                <TextBlock Text="{loc:Loc HeroSubtitle}" FontSize="12" Foreground="#93C5FD" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Margin="0,12,0,14">
                                                <TextBlock Text="{loc:Loc HeroBullet1}" Foreground="#E2E8F0" FontSize="12" Margin="0,2" />
                                                <TextBlock Text="{loc:Loc HeroBullet2}" Foreground="#E2E8F0" FontSize="12" Margin="0,2" />
                                                <TextBlock Text="{loc:Loc HeroBullet3}" Foreground="#E2E8F0" FontSize="12" Margin="0,2" />
                                                <TextBlock Text="{loc:Loc HeroBullet4}" Foreground="#E2E8F0" FontSize="12" Margin="0,2" />
                                            </StackPanel>

                                            <Button Grid.Row="2" Command="{Binding QuickOptimizeCommand}" Style="{StaticResource EmeraldButtonStyle}"
                                                    HorizontalAlignment="Left" Padding="20,10" FontSize="13" FontWeight="Bold">
                                                <TextBlock Text="{loc:Loc HeroOptimizeBtn}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Section Header -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="{loc:Loc ActiveParamsTitle}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{loc:Loc ActiveParamsSubtitle}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" />
                                </StackPanel>

                                <!-- Bottom Row: 4 Parameter Cards -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Card 1: Adapter & Drayver -->
                                    <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <TextBlock Text="{loc:Loc CardAdapterTitle}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" />
                                                <TextBlock Text="{Binding CurrentNetwork.AdapterName}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CurrentNetwork.InterfaceDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6" TextWrapping="Wrap" MaxHeight="28" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{loc:Loc VersionLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding CurrentNetwork.DriverVersion}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{loc:Loc DateLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding CurrentNetwork.DriverDate}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- MAC copy row -->
                                            <Border Grid.Row="2" Background="#0C1322" CornerRadius="6" Padding="8,4" Margin="0,8,0,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding CurrentNetwork.MacAddress, StringFormat='MAC: {0}'}" FontSize="10" Foreground="#E2E8F0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button HorizontalAlignment="Right" Style="{StaticResource CopyIconButtonStyle}"
                                                            Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding CurrentNetwork.MacAddress}"
                                                            ToolTip="{loc:Loc CopyMacTooltip}">
                                                        <TextBlock Text="📋" FontSize="10" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Card 2: Wi-Fi Kanal & Link -->
                                    <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <TextBlock Text="{loc:Loc CardWifiTitle}" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding CurrentNetwork.ReceiveRateMbps, StringFormat='{}{0} Mbps'}" FontSize="17" FontWeight="Bold" Foreground="#10B981" />
                                                    <TextBlock Text=" (" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                                                    <TextBlock Text="{loc:Loc Link}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                                    <TextBlock Text=")" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                                </StackPanel>
                                            </StackPanel>

                                             <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{loc:Loc StandardLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding CurrentNetwork.RadioTypeDisplay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{loc:Loc ChannelLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding CurrentNetwork.Channel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{loc:Loc FreqLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding CurrentNetwork.BandDisplay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Signal bar -->
                                            <Border Grid.Row="2" Background="#0C1322" CornerRadius="6" Padding="8,4" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc SignalLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding CurrentNetwork.SignalPercentage, StringFormat='{}{0}%'}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,6,0" />
                                                    <ProgressBar Value="{Binding CurrentNetwork.SignalPercentage}" Maximum="100" Width="80" Height="4" Foreground="#10B981" Background="#1E293B" BorderThickness="0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Card 3: IP & Gateway -->
                                    <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <TextBlock Text="{loc:Loc CardIpTitle}" FontSize="12" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,6" />
                                            </StackPanel>

                                            <!-- Copy Local IP -->
                                            <Border Grid.Row="1" Background="#0C1322" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Loc LocalIpLabel}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding CurrentNetwork.IpAddress, FallbackValue='Aniqlanmagan'}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" />
                                                    </StackPanel>
                                                    <Button HorizontalAlignment="Right" Style="{StaticResource CopyIconButtonStyle}"
                                                            Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding CurrentNetwork.IpAddress}"
                                                            ToolTip="{loc:Loc CopyIpBtn}">
                                                        <TextBlock Text="📋" FontSize="10" />
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Copy Gateway (Router) -->
                                            <Border Grid.Row="2" Background="#0C1322" CornerRadius="6" Padding="8,4" Margin="0,8,0,0">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Loc RouterGatewayLabel}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding CurrentNetwork.DefaultGateway, FallbackValue='Aniqlanmagan'}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" />
                                                    </StackPanel>
                                                    <Button HorizontalAlignment="Right" Style="{StaticResource CopyIconButtonStyle}"
                                                            Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding CurrentNetwork.DefaultGateway}">
                                                        <TextBlock Text="📋" FontSize="10" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Card 4: DNS Serverlar -->
                                    <Border Grid.Column="3" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <TextBlock Text="{loc:Loc CardDnsTitle}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,6" />
                                                <TextBlock Text="{loc:Loc DnsServersLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding CurrentNetwork.DnsServers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Dynamic Status Badge & Navigation to Settings -->
                                            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                                <!-- Dynamic Status Box -->
                                                <Border Background="{Binding DnsStatusBadgeBg}" BorderBrush="{Binding DnsStatusBadgeColor}" BorderThickness="1" CornerRadius="6" Padding="7,4" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding DnsStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DnsStatusBadgeColor}" TextWrapping="Wrap" />
                                                </Border>

                                                <!-- Jump to full Optimizations tab -->
                                                <Button Command="{Binding OpenDnsOptimizationsCommand}"
                                                        Style="{StaticResource OutlineButtonStyle}"
                                                        Padding="8,6" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="⚡ " FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Loc DnsOpenOptimizations}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= TAB 1: DIAGNOSTIKA ================= -->
                    <TabItem>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <!-- Filter and action subheader -->
                                <RowDefinition Height="Auto" />
                                <!-- Progress bar when scanning -->
                                <RowDefinition Height="Auto" />
                                <!-- Diagnostic Cards List -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Subheader with Filter Chips -->
                            <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Title -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc DiagTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="{loc:Loc DiagSubtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Filter Chips -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                        <!-- All -->
                                        <RadioButton GroupName="DiagFilters" Style="{StaticResource FilterChipRadioButtonStyle}"
                                                     IsChecked="{Binding SelectedDiagnosticFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=All, Mode=TwoWay}"
                                                     Command="{Binding SetFilterCommand}" CommandParameter="All">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:Loc FilterAllPrefix}" />
                                                <TextBlock Text="{Binding TotalChecksCount, StringFormat=' ({0})'}" />
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- Issues -->
                                        <RadioButton GroupName="DiagFilters" Style="{StaticResource FilterChipRadioButtonStyle}"
                                                     IsChecked="{Binding SelectedDiagnosticFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Issues, Mode=TwoWay}"
                                                     Command="{Binding SetFilterCommand}" CommandParameter="Issues">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:Loc FilterIssuesPrefix}" Foreground="#EF4444" />
                                                <TextBlock Text="{Binding IssuesCount, StringFormat=' ({0})'}" Foreground="#EF4444" />
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- Success -->
                                        <RadioButton GroupName="DiagFilters" Style="{StaticResource FilterChipRadioButtonStyle}"
                                                     IsChecked="{Binding SelectedDiagnosticFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Success, Mode=TwoWay}"
                                                     Command="{Binding SetFilterCommand}" CommandParameter="Success">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:Loc FilterNormalPrefix}" Foreground="#10B981" />
                                                <TextBlock Text="{Binding SuccessCount, StringFormat=' ({0})'}" Foreground="#10B981" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>

                                    <!-- Run All Button -->
                                    <Button Grid.Column="2" Command="{Binding StartDiagnosticsCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource PrimaryButtonStyle}" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Text="{loc:Loc RecheckingBtn}" />
                                            <TextBlock Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}}" Text="{loc:Loc RecheckBtn}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Scan Progress indicator (when scanning) -->
                            <Border Grid.Row="1" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#0E192E" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding CurrentScanStepText}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding ScanProgressPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="#93C5FD" />
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Value="{Binding ScanProgressPercent}" Maximum="100" Height="5" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0" />
                                </Grid>
                            </Border>

                            <!-- Filtered Diagnostic Cards List -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding FilteredDiagnosticItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCardBrush}" BorderBrush="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                    BorderThickness="1.5" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Details -->
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <!-- Status Badge -->
                                                            <Border Background="{Binding Status, Converter={StaticResource StatusToBgColorConverter}}"
                                                                    BorderBrush="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                                    BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToBadgeTextConverter}}"
                                                                           FontSize="10" FontWeight="Bold"
                                                                           Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                                            </Border>

                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />

                                                        <!-- Diagnostic Finding / Result Box -->
                                                        <!-- CASE 1: Quote-styled Callout for Warnings and Issues -->
                                                        <Border Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Background="{Binding Status, Converter={StaticResource StatusToQuoteBgConverter}}"
                                                                BorderBrush="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                                BorderThickness="4,0,0,0" CornerRadius="0,8,8,0"
                                                                Padding="14,10" Margin="0,4,0,6">
                                                            <StackPanel>
                                                                <!-- Warning Details (Yaqqol va Tushunarli) -->
                                                                <DockPanel Margin="0,0,0,2">
                                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToQuoteIconConverter}}"
                                                                               FontSize="13" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding Details}" FontSize="12.5" FontWeight="SemiBold"
                                                                               Foreground="{Binding Status, Converter={StaticResource StatusToQuoteTextColorConverter}}"
                                                                               TextWrapping="Wrap" LineHeight="18" />
                                                                </DockPanel>

                                                                <!-- Tavsiya (Faqat ogohlantirish berilgan cardlarda chiqadi) -->
                                                                <Border Visibility="{Binding ShowRecommendation, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Background="#00000030" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6"
                                                                        Padding="10,8" Margin="0,8,0,0">
                                                                    <DockPanel>
                                                                        <TextBlock Text="{loc:Loc RecommendationPrefix}" FontSize="11.5" FontWeight="Bold"
                                                                                   Foreground="#38BDF8" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,6,0" />
                                                                        <TextBlock Text="{Binding Recommendation}" FontSize="11.5" Foreground="#F1F5F9"
                                                                                   TextWrapping="Wrap" LineHeight="17" />
                                                                    </DockPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- CASE 2: Normal Clean Box (No quote, No recommendation) -->
                                                        <Border Visibility="{Binding HasNoWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Background="#090E17" CornerRadius="7" Padding="12,7" Margin="0,2,0,6">
                                                            <DockPanel>
                                                                <TextBlock Text="✔ " Foreground="#10B981" FontWeight="Bold" FontSize="12" Margin="0,0,6,0"
                                                                           DockPanel.Dock="Left" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsNormal, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </Border>

                                                        <!-- Repair Result Message -->
                                                        <TextBlock Text="{Binding RepairMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" Margin="0,4,0,0"
                                                                   Visibility="{Binding RepairMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <!-- Right: Repair Action -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <!-- Auto Repair Button -->
                                                        <Button Visibility="{Binding CanShowRepairButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Command="{Binding RepairCommand}"
                                                                Style="{StaticResource EmeraldButtonStyle}" Padding="14,7">
                                                            <TextBlock Text="{loc:Loc RepairBtn}" FontWeight="SemiBold" FontSize="12" />
                                                        </Button>

                                                        <!-- Repaired Success Badge -->
                                                        <Border Visibility="{Binding IsRepaired, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Background="#142E25" BorderBrush="#059669" BorderThickness="1" CornerRadius="7" Padding="10,5">
                                                            <TextBlock Text="{loc:Loc RepairedBadge}" FontWeight="SemiBold" Foreground="#10B981" FontSize="11" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ================= TAB 2: OPTIMIZATSIYA ================= -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                                <!-- Header Banner -->
                                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc OptTitle}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                            <TextBlock Text="{loc:Loc OptSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding QuickOptimizeCommand}" Style="{StaticResource EmeraldButtonStyle}" Padding="16,8">
                                            <TextBlock Text="{loc:Loc OptQuickFixBtn}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Group 1: Recommended Core Optimizations -->
                                <TextBlock Text="{loc:Loc OptGroupCoreTitle}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding RecommendedRepairActions}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                                                            <Border Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    Background="#1B2844" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                                <TextBlock Text="{loc:Loc AdminRequiredBadge}" FontSize="9" FontWeight="Bold" Foreground="#93C5FD" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{loc:Loc ImpactPrefix}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                            <TextBlock Text="{Binding Impact}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Command="{Binding DataContext.ExecuteRepairActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButtonStyle}" Padding="16,7" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <TextBlock Text="{loc:Loc ExecuteBtn}" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Group 2: DNS & Internet Resolving -->
                                <TextBlock Text="{loc:Loc OptGroupDnsTitle}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding DnsRepairActions}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,3" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{loc:Loc ImpactPrefix}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                            <TextBlock Text="{Binding Impact}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Command="{Binding DataContext.ExecuteRepairActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButtonStyle}" Padding="16,7" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <TextBlock Text="{loc:Loc ExecuteBtn}" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Group 3: Deep Stack Reset -->
                                <TextBlock Text="{loc:Loc OptGroupDeepTitle}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding AdvancedRepairActions}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,3" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{loc:Loc ImpactPrefix}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                                            <TextBlock Text="{Binding Impact}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Command="{Binding DataContext.ExecuteRepairActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButtonStyle}" Padding="16,7" VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <TextBlock Text="{loc:Loc ExecuteBtn}" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= TAB 3: SPEED TEST ================= -->
                    <TabItem>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Hero Speed Test Card -->
                            <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="14" Padding="28,20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Big Clean Speed Number Display -->
                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,12">
                                        <TextBlock Text="{loc:Loc SpeedTitle}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentSpeedMbps, StringFormat='{}{0:F1}'}"
                                                       FontSize="76" FontWeight="Bold" Foreground="#38BDF8"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc SpeedUnitMbps}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Bottom" Margin="8,0,0,16" />
                                        </StackPanel>

                                        <!-- Quality Pill -->
                                        <Border Visibility="{Binding ShowSpeedResults, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="#090E17" BorderBrush="{Binding SpeedQualityColor}" BorderThickness="1.5" CornerRadius="16" Padding="16,5" Margin="0,4,0,0" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SpeedQualityText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding SpeedQualityColor}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Progress Bar during test -->
                                    <ProgressBar Grid.Row="1" Visibility="{Binding IsTestingSpeed, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Value="{Binding ProgressPercentage}" Maximum="100" Minimum="0"
                                                 Width="420" Height="5" Foreground="#38BDF8" Background="#090E17" BorderThickness="0" Margin="0,6,0,16" />

                                    <!-- 4 Telemetry Cards (Visible after test) -->
                                    <Grid Grid.Row="2" Visibility="{Binding ShowSpeedResults, Converter={StaticResource BoolToVisibilityConverter}}"
                                          HorizontalAlignment="Center" Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Card 1: Ping -->
                                        <Border Grid.Column="0" Background="#090E17" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{loc:Loc PingLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding PingLatencyMs}" FontSize="20" FontWeight="Bold" Foreground="#10B981" />
                                                    <TextBlock Text=" ms" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 2: Peak Speed -->
                                        <Border Grid.Column="1" Background="#090E17" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{loc:Loc PeakSpeedLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding PeakSpeedMbps, StringFormat='{}{0:F1}'}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                                                    <TextBlock Text=" Mbps" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 3: Downloaded Data -->
                                        <Border Grid.Column="2" Background="#090E17" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{loc:Loc TotalMbLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding TotalDownloadedMb, StringFormat='{}{0:F1}'}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text=" MB" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 4: Server -->
                                        <Border Grid.Column="3" Background="#090E17" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{loc:Loc ServerLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding SpeedTestServerName, FallbackValue='Cloudflare Global CDN'}" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Test Action Button -->
                                    <Button Grid.Row="3" Command="{Binding RunStandaloneSpeedTestCommand}"
                                            IsEnabled="{Binding IsTestingSpeed, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Padding="32,11" FontSize="14">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Visibility="{Binding IsTestingSpeed, Converter={StaticResource BoolToVisibilityConverter}}" Text="{loc:Loc TestingSpeedBtn}" FontWeight="Bold" />
                                            <TextBlock Visibility="{Binding IsTestingSpeed, Converter={StaticResource InverseBoolToVisibilityConverter}}" Text="{loc:Loc StartSpeedTestBtn}" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Guide & Comparison Box -->
                            <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="{loc:Loc FaqTitle}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8" />
                                        <TextBlock Text="{loc:Loc FaqDesc}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Text="{loc:Loc FaqItem1}" FontSize="11" Foreground="#CBD5E1" Margin="0,2" />
                                        <TextBlock Text="{loc:Loc FaqItem2}" FontSize="11" Foreground="#CBD5E1" Margin="0,2" />
                                        <TextBlock Text="{loc:Loc FaqItem3}" FontSize="11" Foreground="#CBD5E1" Margin="0,2" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#0C1322" CornerRadius="10" Padding="16">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc FaqFixTitle}" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6" />
                                            <TextBlock Text="{loc:Loc FaqFixDesc}"
                                                       FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <Button Command="{Binding QuickOptimizeCommand}" Style="{StaticResource EmeraldButtonStyle}" HorizontalAlignment="Stretch" Padding="14,8">
                                                <TextBlock Text="{loc:Loc FaqFixBtn}" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ================= TAB 4: HARAKATLAR JURNALI ================= -->
                    <TabItem>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Subheader -->
                            <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc LogTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="{loc:Loc LogSubtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding CopyRepairLogCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="12,6" Margin="0,0,8,0">
                                            <TextBlock Text="{loc:Loc CopyLogBtn}" FontSize="11" />
                                        </Button>
                                        <Button Command="{Binding ClearRepairLogCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="12,6">
                                            <TextBlock Text="{loc:Loc ClearLogBtn}" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Terminal Container -->
                            <Border Grid.Row="1" Background="#070B12" BorderBrush="#1F2D44" BorderThickness="1" CornerRadius="10" Padding="14">
                                <Grid>
                                    <!-- Placeholder if empty -->
                                    <TextBlock Text="{loc:Loc LogEmptyPlaceholder}"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding RepairLog, Converter={StaticResource InverseStringToVisibilityConverter}}" />

                                    <TextBox IsReadOnly="True"
                                             Text="{Binding RepairLog, Mode=OneWay}"
                                             Background="Transparent"
                                             Foreground="#93C5FD"
                                             BorderThickness="0"
                                             FontFamily="Consolas, Cascadia Code, Courier New"
                                             FontSize="12"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             TextWrapping="Wrap"
                                             Visibility="{Binding RepairLog, Converter={StaticResource StringToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ================= BOTTOM STATUS BAR ================= -->
        <Border Grid.Row="2" Background="#080C14" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Status Message with Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status dot -->
                    <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,8,0"
                            Background="{Binding CurrentNetwork.IsConnected, Converter={StaticResource ScoreToColorConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Right: Active Connection & Version Summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentNetwork.AdapterName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,0,10,0" />
                    <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding CurrentNetwork.IpAddress, StringFormat='IP: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc AppTitle}" FontSize="11" Foreground="#38BDF8" />
                        <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

